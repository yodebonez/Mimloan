@page "/Loanapplication"
@inherits LoanApplicationBase

<h3>LoanApplicationList</h3>


<h3>Loan Applications</h3>
<button @onclick="() => AddNewLoan()" class="btn btn-primary">New Loan</button>
<table class="table">
    <thead>
        <tr>
            <th>Applicant</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in loans)
        {
            <tr>
                <td>@loan.ApplicantName</td>
                <td>@loan.LoanAmount</td>
                <td>@loan.Status</td>
                <td>
                    <button @onclick="() => EditLoan(loan.Id)">Edit</button>
                    <button @onclick="() => DeleteLoan(loan.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>


